# Sentiment Stock Agent Configuration
# Copy this file to .env and fill in your API keys

# News API (get free key at https://newsapi.org/)
NEWS_API_KEY=your_newsapi_key_here

# Alpha Vantage API (optional, for additional stock data)
# Get free key at https://www.alphavantage.co/
ALPHA_VANTAGE_KEY=your_alphavantage_key_here

# Finnhub API (for real-time stock data and company info)
# Get free key at https://finnhub.io/
FINNHUB_API_KEY=your_finnhub_key_here

# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=True

# Cache settings (in seconds)
CACHE_DURATION=300
